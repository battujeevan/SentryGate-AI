# SentryGate-AI local / compose defaults

# Proxy: comma-separated agent-id:key pairs. Keys must be at least 16 bytes,
# unique, and contain no whitespace. Each agent ID must also be declared in the
# policy file. Never commit real keys.
SENTRYGATE_AGENT_KEYS=agent-sim:dev-secret-change-me

# agent-sim client: the key it presents (must match an entry above).
SENTRYGATE_API_KEY=dev-secret-change-me
SENTRYGATE_URL=http://localhost:8080

SENTRYGATE_ADDR=:8080
SENTRYGATE_POLICY_PATH=policies/default.yaml
SENTRYGATE_AUDIT_DB=data/audit.db
SENTRYGATE_POLICY_RELOAD=5s

TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sentrygate-saga

OTEL_SERVICE_NAME=sentrygate
# stdout | none
OTEL_EXPORTER=none
