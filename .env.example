# SentryGate-AI local / compose defaults
SENTRYGATE_API_KEY=dev-secret-change-me
SENTRYGATE_ADDR=:8080
SENTRYGATE_URL=http://localhost:8080
SENTRYGATE_POLICY_PATH=policies/default.yaml
SENTRYGATE_AUDIT_DB=data/audit.db
SENTRYGATE_POLICY_RELOAD=5s

TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sentrygate-saga

OTEL_SERVICE_NAME=sentrygate
# stdout | none
OTEL_EXPORTER=none
